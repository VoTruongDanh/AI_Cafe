# ============================================
# INTEGRATION FEATURES CONFIGURATION
# ============================================
# Copy these settings to your .env file and configure

# ============================================
# EMAIL CONFIGURATION (for Email Notifications)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# SOCIAL LOGIN CONFIGURATION
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

# ============================================
# FRONTEND URL (for OAuth redirects)
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# NOTES:
# ============================================
# 1. Email: Use Gmail App Password (not regular password)
#    - Go to: https://myaccount.google.com/apppasswords
#    - Generate app password for "Mail"
#
# 2. Google OAuth:
#    - Create project at: https://console.cloud.google.com
#    - Enable Google+ API
#    - Create OAuth 2.0 credentials
#    - Add authorized redirect URI: http://localhost:8000/api/auth/google/callback
#
# 3. Facebook OAuth:
#    - Create app at: https://developers.facebook.com
#    - Add Facebook Login product
#    - Add valid OAuth redirect URI: http://localhost:8000/api/auth/facebook/callback
#
# 4. Install Laravel Socialite:
#    composer require laravel/socialite
#
# 5. Run migration for stock_alerts table:
#    php artisan migrate
