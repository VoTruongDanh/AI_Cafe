# ============================================
# INTEGRATION FEATURES CONFIGURATION
# ============================================
# Copy these settings to your .env file and configure

# ============================================
# API URL
# ============================================
VITE_API_URL=http://localhost:8000/api

# ============================================
# LIVE CHAT CONFIGURATION
# ============================================

# Option 1: Tawk.to (Recommended - Free)
VITE_TAWK_PROPERTY_ID=your-tawk-property-id
VITE_TAWK_WIDGET_ID=your-tawk-widget-id

# Option 2: Crisp Chat (Alternative)
# VITE_CRISP_WEBSITE_ID=your-crisp-website-id

# ============================================
# NOTES:
# ============================================
# 1. Tawk.to Setup (FREE):
#    - Sign up at: https://www.tawk.to
#    - Go to Administration > Channels > Chat Widget
#    - Copy Property ID and Widget ID from the embed code
#    - Example code: https://embed.tawk.to/{PROPERTY_ID}/{WIDGET_ID}
#
# 2. Crisp Chat Setup (FREE with limits):
#    - Sign up at: https://crisp.chat
#    - Go to Settings > Setup instructions
#    - Copy Website ID from the embed code
#    - Example code: window.$crisp=[];window.CRISP_WEBSITE_ID="{WEBSITE_ID}"
#
# 3. Choose ONE chat provider (Tawk.to or Crisp)
#    - Tawk.to: Completely free, unlimited chats
#    - Crisp: Free up to 2 operators, paid plans for more features
#
# 4. The LiveChat component will automatically detect which provider is configured
